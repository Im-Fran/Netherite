# Copy to fastlane/.env and fill in. Never commit the filled copy.
#
# App Store Connect API key — drives match and TestFlight uploads.
# The .p8 itself is not stored here: put it in
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# Private git repo with the encrypted certificates and profiles.
MATCH_REPOSITORY_URL=

# Passphrase that decrypts the match repo. Instead of pasting it here you can
# keep it in the login keychain:
#   security add-generic-password -s fastlane-match-netherite -a match -w
MATCH_PASSWORD=

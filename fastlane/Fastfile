# Netherite — sign and ship the iOS/iPadOS and macOS builds to TestFlight.
#
# The Xcode project is generated from project.yml by XcodeGen and is not
# committed, so every lane regenerates it first. Day-to-day builds sign
# automatically with the team in project.yml; only these lanes switch the
# targets to the match profiles, on the regenerated (throwaway) project.

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "Netherite.xcodeproj")
SCHEME = "Netherite"
BUILD_DIR = "build"
TEAM_ID = File.read(File.join(ROOT, "project.yml"))[/DEVELOPMENT_TEAM:\s*(\S+)/, 1]

# Target => bundle identifier; each one gets its own App Store profile.
TARGETS = {
  "Netherite" => "cl.franciscosolis.netherite",
  "ShareExtension" => "cl.franciscosolis.netherite.share",
  "Widgets" => "cl.franciscosolis.netherite.widgets"
}.freeze

# Keep the match passphrase out of any file on disk: locally it can come from
# the login keychain. CI passes MATCH_PASSWORD as a secret.
if ENV["MATCH_PASSWORD"].to_s.empty?
  keychain_password = `security find-generic-password -s fastlane-match-netherite -w 2>/dev/null`.strip
  ENV["MATCH_PASSWORD"] = keychain_password unless keychain_password.empty?
end

before_all do
  # A throwaway keychain on CI: match has nowhere to put certificates
  # otherwise, and the runner's login keychain is locked.
  setup_ci if is_ci
  sh("xcodegen", "generate", "--quiet", "--spec", "#{ROOT}/project.yml", "--project", ROOT)
end

# One App Store Connect key drives match and uploads alike.
# Locally it is the .p8 on disk; CI passes the same key as a base64 secret.
private_lane :api_key do
  key_id = ENV.fetch("ASC_KEY_ID")
  key_content = ENV["ASC_KEY_CONTENT"]

  if key_content.to_s.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    )
  else
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key_content,
      is_key_content_base64: true
    )
  end
end

desc "Run the core tests"
lane :test do
  sh("swift", "test", "--package-path", File.join(ROOT, "Packages/NetheriteCore"))
end

desc "Create or sync the App Store certificates and profiles for both platforms"
lane :certificates do |options|
  key = api_key
  # Creating material is a local, deliberate act; CI only ever consumes it.
  readonly = options.fetch(:readonly, is_ci)
  match(type: "appstore", platform: "ios", api_key: key, readonly: readonly)
  match(type: "appstore", platform: "macos", api_key: key, readonly: readonly,
        additional_cert_types: ["mac_installer_distribution"])
end

platform :ios do
  desc "Build and upload an iOS/iPadOS build to TestFlight"
  lane :beta do |options|
    key = api_key
    match(type: "appstore", platform: "ios", api_key: key, readonly: true)
    use_match_profiles

    ipa = build_ios_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: { provisioningProfiles: profile_mapping },
      derived_data_path: "#{BUILD_DIR}/DerivedData",
      output_directory: BUILD_DIR,
      archive_path: "#{BUILD_DIR}/Netherite-iOS.xcarchive",
      xcargs: version_xcargs(options, key, "ios")
    )

    upload(ipa: ipa, api_key: key) unless options[:upload] == false
  end
end

platform :mac do
  desc "Build and upload a macOS build to TestFlight"
  lane :beta do |options|
    key = api_key
    match(type: "appstore", platform: "macos", api_key: key, readonly: true,
          additional_cert_types: ["mac_installer_distribution"])
    # On macOS the profile is embedded while archiving, not while exporting, so
    # it has to be on the targets themselves; the export mapping alone is not enough.
    use_match_profiles

    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=macOS",
      # The target is multiplatform: gym only packages a .pkg (instead of
      # looking for an .ipa) when the SDK says macOS.
      sdk: "macosx",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: profile_mapping,
        installerSigningCertificate: "3rd Party Mac Developer Installer"
      },
      derived_data_path: "#{BUILD_DIR}/DerivedData",
      output_directory: BUILD_DIR,
      archive_path: "#{BUILD_DIR}/Netherite-macOS.xcarchive",
      xcargs: version_xcargs(options, key, "osx")
    )

    pkg = lane_context[SharedValues::PKG_OUTPUT_PATH]
    UI.user_error!("no .pkg was produced") if pkg.nil?
    upload(pkg: pkg, api_key: key) unless options[:upload] == false
  end
end

# Only the bundle IDs this project signs: the mapping accumulates across
# match calls and may hold the other platform too.
def profile_mapping
  lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].slice(*TARGETS.values)
end

# Switch every target's Release configuration to manual signing with its match
# profile. Package targets stay untouched: they build static and don't sign.
def use_match_profiles
  TARGETS.each do |target, bundle_id|
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      targets: [target],
      build_configurations: ["Release"],
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: bundle_id,
      profile_name: profile_mapping.fetch(bundle_id)
    )
  end
end

# MARKETING_VERSION comes from project.yml unless a version is passed; the
# build number defaults to one past the latest on TestFlight for that platform.
def version_xcargs(options, key, platform)
  build_number = options[:build_number] || latest_testflight_build_number(
    api_key: key,
    app_identifier: TARGETS["Netherite"],
    platform: platform,
    initial_build_number: 0
  ) + 1
  args = ["CURRENT_PROJECT_VERSION=#{build_number}"]
  args << "MARKETING_VERSION=#{options[:version]}" if options[:version]
  args.join(" ")
end

def upload(api_key:, **package)
  upload_to_testflight(
    api_key: api_key,
    # Processing takes minutes on Apple's side and nothing here depends on it.
    skip_waiting_for_build_processing: true,
    **package
  )
end

# Netherite — sign and ship the iOS/iPadOS and macOS builds to TestFlight, and
# the Developer ID macOS build (notarized .dmg and .zip) for direct download.
#
# The Xcode project is generated from project.yml by XcodeGen and is not
# committed, so every lane regenerates it first. Day-to-day builds sign
# automatically with the team in project.yml; only these lanes switch the
# targets to the match profiles, on the regenerated (throwaway) project.

require_relative "changelog"

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "Netherite.xcodeproj")
SCHEME = "Netherite"
BUILD_DIR = "build"
TEAM_ID = File.read(File.join(ROOT, "project.yml"))[/DEVELOPMENT_TEAM:\s*(\S+)/, 1]
# The key the app checks updates against; the release zip must verify with it.
UPDATER_PUBLIC_KEY = File.read(File.join(ROOT, "Netherite/App/NetheriteApp.swift"))[/publicKey: "([^"]+)"/, 1]
CHANGELOG = File.join(ROOT, "CHANGELOG.md")
REPO_URL = "https://github.com/Im-Fran/Netherite"

# Target => bundle identifier; each one gets its own App Store profile.
TARGETS = {
  "Netherite" => "cl.franciscosolis.netherite",
  "ShareExtension" => "cl.franciscosolis.netherite.share",
  "Widgets" => "cl.franciscosolis.netherite.widgets"
}.freeze

# Keep the match passphrase out of any file on disk: locally it can come from
# the login keychain. CI passes MATCH_PASSWORD as a secret.
if ENV["MATCH_PASSWORD"].to_s.empty?
  keychain_password = `security find-generic-password -s fastlane-match-netherite -w 2>/dev/null`.strip
  ENV["MATCH_PASSWORD"] = keychain_password unless keychain_password.empty?
end

before_all do
  # A throwaway keychain on CI: match has nowhere to put certificates
  # otherwise, and the runner's login keychain is locked.
  setup_ci if is_ci
  sh("xcodegen", "generate", "--quiet", "--spec", "#{ROOT}/project.yml", "--project", ROOT)
end

# One App Store Connect key drives match and uploads alike.
# Locally it is the .p8 on disk; CI passes the same key as a base64 secret.
private_lane :api_key do
  key_id = ENV.fetch("ASC_KEY_ID")
  key_content = ENV["ASC_KEY_CONTENT"]

  if key_content.to_s.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    )
  else
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key_content,
      is_key_content_base64: true
    )
  end
end

desc "Run the core tests"
lane :test do
  sh("swift", "test", "--package-path", File.join(ROOT, "Packages/NetheriteCore"))
end

desc "Create or sync the App Store certificates and profiles for both platforms"
lane :certificates do |options|
  key = api_key
  # Creating material is a local, deliberate act; CI only ever consumes it.
  readonly = options.fetch(:readonly, is_ci)
  match(type: "appstore", platform: "ios", api_key: key, readonly: readonly)
  match(type: "appstore", platform: "macos", api_key: key, readonly: readonly,
        additional_cert_types: ["mac_installer_distribution"])
  # Developer ID signs the notarized .app attached to each GitHub Release.
  match(type: "developer_id", platform: "macos", api_key: key, readonly: readonly)
end

# dev is protected, so a release is two steps: a PR with the stamped
# changelog, then a tag on dev once it is merged (the tag is what CI ships).
desc "Stamp the Unreleased changelog as a version on a release/x.y.z branch and push it for a PR"
desc "Usage: fastlane release version:1.2.0"
lane :release do |options|
  version = release_version(options)
  ensure_git_status_clean

  text = File.read(CHANGELOG, encoding: "UTF-8")
  UI.user_error!("## [Unreleased] in CHANGELOG.md is empty") if Changelog.section(text, "Unreleased").to_s.empty?

  sh("git", "switch", "-c", "release/#{version}")
  File.write(CHANGELOG, Changelog.stamp(text, version, Time.now.strftime("%Y-%m-%d"), REPO_URL))
  project_yml = File.join(ROOT, "project.yml")
  File.write(project_yml, File.read(project_yml).sub(/MARKETING_VERSION: "[^"]*"/, %(MARKETING_VERSION: "#{version}")))

  git_commit(path: [CHANGELOG, project_yml], message: "chore(release): #{version}")
  push_to_git_remote(remote_branch: "release/#{version}")
  UI.success("Open a PR into dev: #{REPO_URL}/pull/new/release/#{version}")
  UI.success("Once merged: fastlane tag version:#{version}")
end

desc "Tag a merged release on dev and push the tag, which starts the CI build"
desc "Usage: fastlane tag version:1.2.0"
lane :tag do |options|
  version = release_version(options)
  ensure_git_status_clean
  sh("git", "switch", "dev")
  sh("git", "pull", "--ff-only")
  UI.user_error!("CHANGELOG.md on dev has no #{version} yet: merge the release PR first") unless Changelog.section(File.read(CHANGELOG, encoding: "UTF-8"), version)
  add_git_tag(tag: version, message: version)
  push_git_tags(tag: version)
end

platform :ios do
  desc "Build and upload an iOS/iPadOS build to TestFlight"
  lane :beta do |options|
    key = api_key
    match(type: "appstore", platform: "ios", api_key: key, readonly: true)
    use_match_profiles

    ipa = build_ios_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: { provisioningProfiles: profile_mapping },
      derived_data_path: "#{BUILD_DIR}/DerivedData",
      output_directory: BUILD_DIR,
      archive_path: "#{BUILD_DIR}/Netherite-iOS.xcarchive",
      xcargs: version_xcargs(options, key, "ios")
    )

    upload(ipa: ipa, api_key: key, version: options[:version], build: options[:build_number]) unless options[:upload] == false
  end
end

platform :mac do
  desc "Build and upload a macOS build to TestFlight"
  lane :beta do |options|
    key = api_key
    match(type: "appstore", platform: "macos", api_key: key, readonly: true,
          additional_cert_types: ["mac_installer_distribution"])
    # On macOS the profile is embedded while archiving, not while exporting, so
    # it has to be on the targets themselves; the export mapping alone is not enough.
    use_match_profiles

    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=macOS",
      # The target is multiplatform: gym only packages a .pkg (instead of
      # looking for an .ipa) when the SDK says macOS.
      sdk: "macosx",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: profile_mapping,
        installerSigningCertificate: "3rd Party Mac Developer Installer"
      },
      derived_data_path: "#{BUILD_DIR}/DerivedData",
      output_directory: BUILD_DIR,
      archive_path: "#{BUILD_DIR}/Netherite-macOS.xcarchive",
      xcargs: version_xcargs(options, key, "osx")
    )

    pkg = lane_context[SharedValues::PKG_OUTPUT_PATH]
    UI.user_error!("no .pkg was produced") if pkg.nil?
    upload(pkg: pkg, api_key: key, version: options[:version], build: options[:build_number]) unless options[:upload] == false
  end

  # The App Store .pkg above is signed for the store only: Gatekeeper rejects it
  # when opened directly. Direct downloads get their own build: Developer ID,
  # no sandbox, OpenUpdater compiled in, notarized and stapled.
  desc "Build the notarized Developer ID app as build/Netherite.dmg and build/Netherite.zip (+ .zip.sig for OpenUpdater)"
  lane :direct do |options|
    key = api_key
    match(type: "developer_id", platform: "macos", api_key: key, readonly: true)
    use_match_profiles(identity: "Developer ID Application")

    out = File.join(ROOT, BUILD_DIR)
    archive = File.join(out, "Netherite-direct.xcarchive")
    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=macOS",
      sdk: "macosx",
      skip_package_pkg: true,
      derived_data_path: "#{BUILD_DIR}/DerivedData",
      output_directory: File.join(out, "archived"),
      archive_path: archive,
      xcargs: [
        version_xcargs(options, key, "osx"),
        "NETHERITE_CONDITIONS=DIRECT_DISTRIBUTION",
        "NETHERITE_ENTITLEMENTS=Netherite/NetheriteDirect.entitlements"
      ].join(" ")
    )
    # gym never re-exports a macOS archive for Developer ID: it copies the
    # archived .app as is. So export it directly.
    export = File.join(out, "direct")
    options_plist = File.join(out, "DeveloperIDExportOptions.plist")
    File.write(options_plist, {
      "method" => "developer-id",
      "signingStyle" => "manual",
      "signingCertificate" => "Developer ID Application",
      "teamID" => TEAM_ID,
      "provisioningProfiles" => profile_mapping
    }.to_plist)
    sh("rm", "-rf", export)
    sh("xcodebuild", "-exportArchive", "-archivePath", archive, "-exportOptionsPlist", options_plist, "-exportPath", export)
    app = File.join(export, "Netherite.app")
    # Leaves build/release-notes.md for the GitHub Release.
    release_notes(options[:version], options[:build_number])

    # Notarize the app first: the zip OpenUpdater installs must carry the stapled ticket.
    notarize(package: app, api_key: key)

    zip = File.join(out, "Netherite.zip")
    sh("ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", app, zip)
    openupdater("sign", zip, *[ENV["OPENUPDATER_PRIVATE_KEY"].to_s.empty? ? File.expand_path("~/.openupdater/netherite.key") : nil].compact)
    openupdater("verify", zip, UPDATER_PUBLIC_KEY)

    # The .dmg for people downloading by hand: the app plus an Applications link to drag it to.
    dmg = File.join(out, "Netherite.dmg")
    stage = File.join(out, "dmg")
    sh("rm", "-rf", stage, dmg)
    sh("mkdir", "-p", stage)
    sh("ditto", app, File.join(stage, "Netherite.app"))
    sh("ln", "-s", "/Applications", File.join(stage, "Applications"))
    sh("hdiutil", "create", "-volname", "Netherite", "-srcfolder", stage, "-format", "UDZO", "-ov", dmg)
    sh("codesign", "--sign", "Developer ID Application", "--timestamp", dmg)
    notarize(package: dmg, api_key: key)
  end
end

# openupdater-cli signs and verifies the update zip (Ed25519). The private key
# comes from OPENUPDATER_PRIVATE_KEY on CI, or a key file locally.
def openupdater(*args)
  # The same pinned revision the app links (project.yml): this code runs with the private key.
  revision = File.read(File.join(ROOT, "project.yml"))[/openupdater\n\s+revision:\s*(\h{40})/, 1] or UI.user_error!("OpenUpdater revision not pinned in project.yml")
  tool = File.join(ROOT, BUILD_DIR, "openupdater")
  unless File.directory?(tool)
    sh("git", "init", "-q", tool)
    sh("git", "-C", tool, "fetch", "-q", "--depth", "1", "https://github.com/Im-Fran/openupdater", revision)
    sh("git", "-C", tool, "checkout", "-q", "FETCH_HEAD")
  end
  sh("swift", "run", "-c", "release", "--package-path", tool, "openupdater-cli", *args)
end

# Only the bundle IDs this project signs: the mapping accumulates across
# match calls and may hold the other platform too.
def profile_mapping
  lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].slice(*TARGETS.values)
end

# Switch every target's Release configuration to manual signing with its match
# profile. Package targets stay untouched: they build static and don't sign.
def use_match_profiles(identity: "Apple Distribution")
  TARGETS.each do |target, bundle_id|
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      targets: [target],
      build_configurations: ["Release"],
      team_id: TEAM_ID,
      code_sign_identity: identity,
      bundle_identifier: bundle_id,
      profile_name: profile_mapping.fetch(bundle_id)
    )
  end
end

# MARKETING_VERSION comes from project.yml unless a version is passed; the
# build number defaults to one past the latest on TestFlight for that platform.
def version_xcargs(options, key, platform)
  build_number = options[:build_number] || latest_testflight_build_number(
    api_key: key,
    app_identifier: TARGETS["Netherite"],
    platform: platform,
    initial_build_number: 0
  ) + 1
  args = ["CURRENT_PROJECT_VERSION=#{build_number}"]
  args << "MARKETING_VERSION=#{options[:version]}" if options[:version]
  args.join(" ")
end

def upload(api_key:, version:, build:, **package)
  notes = release_notes(version, build)
  upload_to_testflight(
    api_key: api_key,
    changelog: notes,
    # TestFlight only takes the notes once the build is processed; without
    # notes nothing here depends on processing, so don't wait for it.
    skip_waiting_for_build_processing: notes.nil?,
    **package
  )
end

def release_version(options)
  version = options[:version].to_s
  UI.user_error!("pass version:x.y.z") unless version.match?(/\A\d+\.\d+\.\d+\z/)
  version
end

# The CHANGELOG section of version+build, else of the version (Unreleased when
# it has neither yet). Also left in build/release-notes.md for the GitHub Release.
def release_notes(version, build = nil)
  section = Changelog.build_section(File.read(CHANGELOG, encoding: "UTF-8"), version, build)
  return nil if section.to_s.empty?
  File.write(File.join(ROOT, BUILD_DIR, "release-notes.md"), section)
  # TestFlight rejects "What to Test" over 4000 characters.
  Changelog.release_notes(section)[0, 4000]
end

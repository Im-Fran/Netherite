      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↩ abrir · ⌘↩ abrir en panel nuevo · ⇧↩ crear"
          }
        }
      }
    }
  },
  "version" : "1.0"

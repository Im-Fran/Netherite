    },
    "welcome.note" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "# Welcome to Netherite\n\nThis is your new vault — a folder of plain Markdown files.\n\n- Create a note with ⌘N and link it with [[double brackets]].\n- Press ⌘O to jump to any note and ⌘P for every command.\n- Add #tags, callouts and $math$ as you go.\n\n> [!tip] Your notes are yours\n> Everything lives in this folder, readable by any app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Te damos la bienvenida a Netherite\n\nEsta es tu nueva bóveda: una carpeta de archivos Markdown simples.\n\n- Crea una nota con ⌘N y enlázala con [[dobles corchetes]].\n- Pulsa ⌘O para ir a cualquier nota y ⌘P para ver todos los comandos.\n- Agrega #etiquetas, destacados y $math$ mientras escribes.\n\n> [!tip] Tus notas son tuyas\n> Todo vive en esta carpeta, legible por cualquier app."
          }
        }
      }
    },
    "“%@” couldn't be opened." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir “%@”."
          }
        }
      }
    },
    "“%@” doesn't exist yet" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” aún no existe"
